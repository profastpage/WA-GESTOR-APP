rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Activation codes - only super admin can write, anyone can read (to validate)
    match /activationCodes/{codeId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && request.auth.token.email == 'admin@wamanger.com';
    }
    
    // Clients - authenticated users can CRUD their own data
    match /clients/{clientId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }
    
    // Templates - authenticated users can CRUD their own data
    match /templates/{templateId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }
    
    // Messages - authenticated users can CRUD their own data
    match /messages/{messageId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }
    
    // Follow-ups - authenticated users can CRUD their own data
    match /followups/{followUpId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }
    
    // License activations - anyone can read to validate, only admin can write
    match /licenseActivations/{activationId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'admin@wamanger.com';
    }
  }
}

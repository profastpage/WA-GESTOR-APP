generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String   @default("")
  password  String   @default("")
  role      String   @default("client") // client, admin
  approved  Boolean  @default(false)
  isPro     Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clients     Client[]
  templates   Template[]
  messages    Message[]
  followUps   FollowUp[]
  licenseKeys LicenseKey[]
}

model Client {
  id            String   @id @default(cuid())
  userId        String
  name          String   @default("")
  phone         String   @default("")
  email         String   @default("")
  company       String   @default("")
  tags          String   @default("Nuevo") // JSON string array: ["Nuevo","VIP"]
  notes         String   @default("") // JSON string array: [{"text":"...","date":"..."}]
  totalMessages Int      @default(0)
  lastContact   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]
  followUps FollowUp[]
}

model Template {
  id         String   @id @default(cuid())
  userId     String
  name       String   @default("")
  content    String   @default("")
  category   String   @default("general")
  usageCount Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]
}

model Message {
  id         String   @id @default(cuid())
  userId     String
  clientId   String
  templateId String?
  content    String   @default("")
  type       String   @default("outgoing") // outgoing, incoming
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  client   Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  template Template? @relation(fields: [templateId], references: [id], onDelete: SetNull)
}

model FollowUp {
  id          String    @id @default(cuid())
  userId      String
  clientId    String
  title       String    @default("")
  description String    @default("")
  dueDate     DateTime
  priority    String    @default("media") // baja, media, alta
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model LicenseKey {
  id          String    @id @default(cuid())
  key         String    @unique
  plan        String    @default("pro")
  used        Boolean   @default(false)
  usedBy      String?
  usedByEmail String?
  createdAt   DateTime  @default(now())
  usedAt      DateTime?

  user User? @relation(fields: [usedBy], references: [id], onDelete: SetNull)
}
